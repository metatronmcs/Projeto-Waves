model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["fato_previsao_surf","dim_condicao_ia","dim_praias","dim_calendario"]

ref table fato_previsao_surf
ref table dim_condicao_ia
ref table dim_praias
ref table dim_calendario

ref cultureInfo pt-BR

